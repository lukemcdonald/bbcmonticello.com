{
  "name": "@bbcmonticello/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "astro": "astro",
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf .astro dist node_modules",
    "deploy:prod": "netlify deploy --build --prod",
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "format": "prettier --write .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --fix --report-unused-disable-directives",
    "preinstall": "npx only-allow pnpm",
    "preview": "netlify deploy --build --message \"preview $(git rev-parse --short HEAD)\"",
    "start": "pnpm run dev",
    "typecheck": "astro check",
    "validate": "pnpm run -s lint && pnpm run -s format:check && pnpm run -s typecheck"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "astro-og-kit": "0.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "fallow": "^3.34.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.4.2"
}
