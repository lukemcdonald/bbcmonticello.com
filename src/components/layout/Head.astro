---
import '@/styles/global.css'

import { HEIGHT, WIDTH } from 'astro-og-kit'
import OgMeta from 'astro-og-kit/OgMeta.astro'
import { Font, getImage } from 'astro:assets'

import ogImage from '@/assets/bbc-og.jpg'
import { getChurchJsonLd, SITE_TITLE } from '@/config'
import { normalizePath } from '@/lib/pathname'
import { og } from '@/og'

export interface Props {
  description: string
  title: string
}

const { description, title } = Astro.props
const site = Astro.site ?? Astro.url
const canonicalPath = normalizePath(Astro.url.pathname)
const pageUrl = new URL(canonicalPath, site)
const defaultOgImage = await getImage({
  format: 'jpg',
  height: HEIGHT,
  layout: 'none',
  src: ogImage,
  width: WIDTH,
})
const churchJsonLd =
  canonicalPath === '/' ?
    JSON.stringify(
      getChurchJsonLd({
        image: new URL(og.path(canonicalPath), site).href,
        url: pageUrl.href,
      }),
    )
  : null
---

<head>
  <!-- Global Metadata -->
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <!-- Sitemap -->
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta
    name="title"
    content={title}
  />
  <meta
    name="description"
    content={description}
  />
  <link
    rel="canonical"
    href={pageUrl}
  />

  <!-- Google -->
  <meta
    name="google-site-verification"
    content="Ua3-yrg0f1qjkE74afVsNPJZjCHzuOIleJThz2Oj7GY"
  />

  <!-- Open Graph / Twitter -->
  <OgMeta
    description={description}
    image={canonicalPath === '/404' ? defaultOgImage.src : undefined}
    og={og}
    siteName={SITE_TITLE}
    title={title}
    url={pageUrl}
  />
  {churchJsonLd && (
    <script
      is:inline
      set:html={churchJsonLd}
      type="application/ld+json"
    />
  )}

  <!-- Fonts -->
  <Font
    cssVariable="--font-lato"
    preload
  />
  <Font
    cssVariable="--font-merriweather"
    preload
  />

  <slot />
</head>
