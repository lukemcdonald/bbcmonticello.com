---
import '@/styles/global.css'

import { Font, getImage } from 'astro:assets'

import ogImage from '@/assets/bbc-og.jpg'
import { getChurchJsonLd, SITE_TITLE } from '@/config'
import { normalizePath } from '@/lib/pathname'
import { buildOgImagePath, OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '@/utils/og'

export interface Props {
  description: string
  image?: string
  title: string
}

const { description, image, title } = Astro.props
const site = Astro.site ?? Astro.url
const canonicalPath = normalizePath(Astro.url.pathname)
const pageUrl = new URL(canonicalPath, site)
const defaultOgImage = await getImage({
  format: 'jpg',
  height: OG_IMAGE_HEIGHT,
  layout: 'none',
  src: ogImage,
  width: OG_IMAGE_WIDTH,
})
const socialImagePath =
  image ?? (canonicalPath === '/404' ? defaultOgImage.src : buildOgImagePath(canonicalPath))
const socialImageUrl = new URL(socialImagePath, site)
const churchJsonLd =
  canonicalPath === '/' ?
    JSON.stringify(
      getChurchJsonLd({
        image: socialImageUrl.href,
        url: pageUrl.href,
      }),
    )
  : null
---

<head>
  <!-- Global Metadata -->
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <!-- Sitemap -->
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta
    name="title"
    content={title}
  />
  <meta
    name="description"
    content={description}
  />
  <link
    rel="canonical"
    href={pageUrl}
  />

  <!-- Google -->
  <meta
    name="google-site-verification"
    content="Ua3-yrg0f1qjkE74afVsNPJZjCHzuOIleJThz2Oj7GY"
  />

  <!-- Open Graph / Facebook -->
  <meta
    property="og:type"
    content="website"
  />
  <meta
    property="og:site_name"
    content={SITE_TITLE}
  />
  <meta
    property="og:url"
    content={pageUrl}
  />
  <meta
    property="og:title"
    content={title}
  />
  <meta
    property="og:description"
    content={description}
  />
  <meta
    property="og:image"
    content={socialImageUrl}
  />
  {!image && (
    <>
      <meta
        property="og:image:width"
        content={String(OG_IMAGE_WIDTH)}
      />
      <meta
        property="og:image:height"
        content={String(OG_IMAGE_HEIGHT)}
      />
    </>
  )}
  {churchJsonLd && (
    <script
      is:inline
      set:html={churchJsonLd}
      type="application/ld+json"
    />
  )}

  <!-- Twitter -->
  <meta
    name="twitter:card"
    content="summary_large_image"
  />
  <meta
    name="twitter:url"
    content={pageUrl}
  />
  <meta
    name="twitter:title"
    content={title}
  />
  <meta
    name="twitter:description"
    content={description}
  />
  <meta
    name="twitter:image"
    content={socialImageUrl}
  />

  <!-- Fonts -->
  <Font
    cssVariable="--font-lato"
    preload
  />
  <Font
    cssVariable="--font-merriweather"
    preload
  />

  <slot />
</head>
