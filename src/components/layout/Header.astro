---
import Breadcrumbs, { type Breadcrumb } from '@/components/Breadcrumbs.astro'
import SiteIdentity from '@/components/SiteIdentity.astro'
import SiteNavigation from '@/components/SiteNavigation.astro'

export interface Props {
  breadcrumbs?: Breadcrumb[]
}

const { breadcrumbs } = Astro.props
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html'
---

<a
  class="skip-link sr-only"
  href="#content"
  >Skip to content</a
>

<header
  id="masthead"
  class="relative z-50 bg-primary-500 text-white"
  role="banner"
>
  <SiteNavigation />
  <SiteIdentity isHome={isHome} />
  {breadcrumbs ?
    <Breadcrumbs links={breadcrumbs} />
  : null}
  <slot />
</header>
