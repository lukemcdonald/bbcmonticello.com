---
import type { ImageMetadata } from 'astro'

import { Picture } from 'astro:assets'

export interface Props {
  image: ImageMetadata
  imageAlt?: string
}

const { image, imageAlt = '' } = Astro.props
---

<section
  id="hero"
  class="relative top-12 z-10 -mt-12 mb-12"
>
  <div class="relative z-10 px-6 xl:px-0 2xl:container 2xl:mx-auto">
    <figure class="flex items-center overflow-hidden rounded bg-gray-900 shadow-md">
      <Picture
        alt={imageAlt}
        fallbackFormat="webp"
        fetchpriority="high"
        formats={['avif', 'webp']}
        height={image.height}
        loading="eager"
        sizes="(min-width: 1280px) 1280px, 100vw"
        src={image}
        width={image.width}
        widths={[640, 960, 1280, image.width]}
      />
    </figure>
  </div>
</section>
