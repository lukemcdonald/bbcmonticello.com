---
import Logo from '@/components/Logo.astro'
import {
  SITE_ADDRESS,
  SITE_ADDRESS_LOCALITY,
  SITE_DESCRIPTION,
  SITE_MAPS_URL,
  SITE_TITLE,
} from '@/config'

interface Props {
  isHome?: boolean
}

const { isHome = false } = Astro.props
const TitleTag = isHome ? 'h1' : 'p'
---

<section>
  <div class="px-6 py-8 sm:flex sm:items-center sm:justify-between 2xl:container 2xl:mx-auto">
    <div>
      <div class="w-40 sm:w-48">
        <a
          class="block"
          rel="home"
          href="/"
          aria-label="Home"
        >
          <Logo />
        </a>
      </div>
      <TitleTag
        class="sr-only font-sans text-2xl leading-tight font-normal tracking-widest uppercase lg:text-4xl"
      >
        {SITE_TITLE}
      </TitleTag>
      <p class="sr-only mb-0 hidden text-base leading-tight md:block">
        {SITE_DESCRIPTION}
      </p>
    </div>
    <div class="text-sm italic">
      <address class="business-info mt-6 sm:mt-0 sm:text-right">
        <a
          class="block"
          href={SITE_MAPS_URL}
        >
          <div class="sr-only font-bold">{SITE_TITLE}</div>
          <div>{SITE_ADDRESS.street}</div>
          <div>{SITE_ADDRESS_LOCALITY}</div>
        </a>
      </address>
    </div>
  </div>
</section>
