---
import type { Breadcrumb } from '@/components/Breadcrumbs.astro'

import Body from '@/components/layout/Body.astro'
import Content from '@/components/layout/Content.astro'
import Footer from '@/components/layout/Footer.astro'
import Head from '@/components/layout/Head.astro'
import Header from '@/components/layout/Header.astro'
import Html from '@/components/layout/Html.astro'
import Main from '@/components/layout/Main.astro'

export interface Props {
  breadcrumbs?: Breadcrumb[]
  description: string
  title: string
}

const { breadcrumbs, description, title } = Astro.props
---

<Html>
  <Head
    description={description}
    title={title}
  />

  <Body>
    <Header breadcrumbs={breadcrumbs}>
      <slot name="header" />
    </Header>
    <Content>
      <Main>
        <slot />
      </Main>
      <slot name="sidebar" />
    </Content>
    <Footer />
  </Body>
</Html>
